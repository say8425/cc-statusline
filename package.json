{
	"name": "@say8425/cc-statusline",
	"version": "4.0.0",
	"description": "Custom statusline for Claude Code",
	"repository": {
		"type": "git",
		"url": "https://github.com/say8425/cc-statusline.git"
	},
	"bin": {
		"cc-statusline": "dist/index.js"
	},
	"files": [
		"dist/index.js"
	],
	"type": "module",
	"publishConfig": {
		"registry": "https://registry.npmjs.org"
	},
	"scripts": {
		"build": "bun build.ts",
		"start": "bun src/index.ts",
		"test": "bun test",
		"test:coverage": "bun test --coverage",
		"lint": "oxlint src/",
		"format": "oxfmt src/ build.ts",
		"format:check": "oxfmt --check src/ build.ts",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@say8425/diffdeck": "^0.2.2"
	},
	"devDependencies": {
		"@types/bun": "^1.3.14",
		"oxfmt": "^0.57.0",
		"oxlint": "^1.72.0",
		"oxlint-tsgolint": "^0.24.0",
		"typescript": "^6.0.3"
	}
}
