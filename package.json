{
	"name": "@say8425/cc-statusline",
	"version": "3.2.0",
	"repository": {
		"type": "git",
		"url": "https://github.com/say8425/cc-statusline.git"
	},
	"devDependencies": {
		"@pierre/diffs": "^1.2.12",
		"@pierre/trees": "^1.0.0-beta.5",
		"@types/bun": "^1.3.14",
		"oxfmt": "^0.57.0",
		"oxlint": "^1.72.0",
		"oxlint-tsgolint": "^0.24.0",
		"typescript": "^6.0.3"
	},
	"bin": {
		"cc-statusline": "dist/index.js"
	},
	"description": "Custom statusline for Claude Code",
	"files": [
		"dist/index.js",
		"dist/viewer"
	],
	"publishConfig": {
		"registry": "https://registry.npmjs.org"
	},
	"scripts": {
		"build": "bun build.ts",
		"start": "bun src/index.ts",
		"test": "bun test",
		"test:coverage": "bun test --coverage",
		"lint": "oxlint src/",
		"format": "oxfmt src/ build.ts",
		"format:check": "oxfmt --check src/ build.ts",
		"typecheck": "tsc --noEmit"
	},
	"type": "module"
}
